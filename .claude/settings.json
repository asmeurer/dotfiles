{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:data-apis.org)",
      "WebFetch(domain:dmlc.github.io)",
      "WebFetch(domain:stackoverflow.com)",
      "Bash(cat:*)",
      "Bash(gh run:*)",
      "WebFetch(domain:cibuildwheel.pypa.io)",
      "Bash(git rev-parse:*)",
      "Bash(git tag:*)",
      "Bash(git log:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(asv:*)",
      "WebFetch(domain:asv.readthedocs.io)",
      "Bash(pip index:*)"
    ],
    "deny": [],
    "ask": [
      "Bash(/Users/aaronmeurer/.claude/bin/cc-run:*)",
      "Bash(cc-run:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "skillOverrides": {
    "roborev-fix": "off",
    "roborev-review": "off",
    "roborev-review-branch": "off",
    "roborev-design-review": "off",
    "roborev-design-review-branch": "off",
    "roborev-lookahead-review": "off",
    "roborev-lookahead-review-branch": "off",
    "roborev-refine": "off",
    "roborev-respond": "off"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/aaronmeurer/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-notify.py Notification"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-keep-awake.py Notification",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/aaronmeurer/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/aaronmeurer/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/auto-swap-on-low-usage.py",
            "timeout": 45
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-keep-awake.py PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/auto-swap-on-low-usage.py",
            "timeout": 45
          }
        ]
      },
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/auto-swap-on-low-usage.py",
            "timeout": 45
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/aaronmeurer/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-notify.py PreToolUse"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-keep-awake.py PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/aaronmeurer/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-notify.py SessionEnd"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-keep-awake.py SessionEnd",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/aaronmeurer/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/cc-session-name.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-keep-awake.py SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/aaronmeurer/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/auto-swap-on-low-usage.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-notify.py Stop"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-keep-awake.py Stop",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/aaronmeurer/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/auto-swap-on-low-usage.py",
            "timeout": 45
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-keep-awake.py StopFailure",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/auto-swap-on-low-usage.py",
            "timeout": 45
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/aaronmeurer/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/aaronmeurer/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/cc-session-name.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/auto-swap-on-low-usage.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-notify.py UserPromptSubmit"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-keep-awake.py UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-freeze.sh bash ~/.claude/statusline-command.sh",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "claude-notifications-go@claude-notifications-go": false
  },
  "extraKnownMarketplaces": {
    "claude-notifications-go": {
      "source": {
        "source": "github",
        "repo": "777genius/claude-notifications-go"
      }
    }
  },
  "spellcheck": {
    "enabled": true,
    "checker": "hunspell",
    "language": "en_US-large"
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "advisorModel": "fable",
  "tui": "default",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "showThinkingSummaries": true,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": true,
  "preferredNotifChannel": "notifications_disabled",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
